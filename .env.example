# ==============================================================
# HRP AI Assistant & RAG Chatbot - Environment Configuration
# ==============================================================

# Server Settings
PORT=8000
HOST=0.0.0.0

# LLM Inference (OpenAI-compatible endpoint, vLLM, or Ollama)
# e.g., https://your-vllm-server.com/v1 or http://localhost:11434/v1
CHAT_BASE_URL=https://your-llm-server.com/v1
CHAT_API_KEY=your_api_key_here
CHAT_MODEL=gemma4-31b

# Embedding Inference (BGE-M3 or compatible multilingual embedding model)
EMBEDDING_BASE_URL=https://your-llm-server.com/v1
EMBEDDING_MODEL=bge-m3

# Fallback local Ollama host
OLLAMA_HOST=http://127.0.0.1:11434

# RAG & Vector Store Tuning Parameters
HR_CHATBOT_TOP_K=5
HR_CHATBOT_MIN_RELEVANCE_SCORE=0.58
HR_CHATBOT_CROSS_LINGUAL_MIN_RELEVANCE_SCORE=0.46
HR_CHATBOT_CHUNK_SIZE=1200
HR_CHATBOT_CHUNK_OVERLAP=180
HR_CHATBOT_TIMEOUT_SECONDS=120
HR_CHATBOT_NUM_CTX=8192
HR_CHATBOT_NUM_PREDICT=1024
HR_CHATBOT_TEMPERATURE=0.0

# Paths
HR_CHATBOT_MANUALS_DIR=manuals
HR_CHATBOT_VECTOR_STORE_PATH=storage/vector_store.json
